{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "DurationInMinutes": 15,
    "ExpiryDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Company": { "TimeZone": "Africa/Cairo" },
  "Finance": { "DefaultTaxRate": 14, "DefaultDueDays": 30 },
  "Payments": {
    "Provider": "",
    "Paymob": {
      "ApiBaseUrl": "https://accept.paymob.com",
      "CheckoutBaseUrl": "https://eg.checkout.paymob.com",
      "TimeoutSeconds": 10
    },
    "Refunds": { "Enabled": true, "PollSeconds": 30 }
  },
  "Reminders": {
    "Day": "Sunday",
    "SendAt": "10:00",
    "CatchUpDays": 1,
    "Worker": { "PollSeconds": 300 }
  },
  "RateLimits": {
    "Login":     { "PermitLimit": 10,  "WindowSeconds": 60 },
    "Refresh":   { "PermitLimit": 30,  "WindowSeconds": 60 },
    "Webhook":   { "PermitLimit": 120, "WindowSeconds": 60 },
    "PerClient": { "PermitLimit": 600, "WindowSeconds": 60 }
  },
  "ForwardedHeaders": { "KnownProxies": [] }
}
