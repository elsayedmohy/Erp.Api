# Copy to deploy/.env.prod and fill in. deploy/.env.prod is git-ignored.
PUBLIC_HOST=erp.local
APP_VERSION=local

DB_PASSWORD=            # openssl rand -base64 24
JWT_KEY=                # openssl rand -base64 48   (at least 32 bytes)
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=         # 12+ characters

BACKUP_KEEP_DAYS=7
